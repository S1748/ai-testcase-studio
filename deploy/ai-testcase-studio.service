[Unit]
Description=AI Testcase Studio API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aitc
Group=aitc
WorkingDirectory=/opt/ai-testcase-studio/current/backend
EnvironmentFile=/etc/ai-testcase-studio/aitc.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ai-testcase-studio/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-testcase-studio

[Install]
WantedBy=multi-user.target
